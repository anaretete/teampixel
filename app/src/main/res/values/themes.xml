<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PixeLK" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and icon background. -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <!-- Use windowSplashScreenAnimatedIcon to add either a drawable or an animated drawable. One of these is required. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. This is required. -->
        <item name="postSplashScreenTheme">@style/Theme.PixeLK</item>
    </style>
</resources>