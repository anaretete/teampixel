<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and icon background. -->
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PixeLK</item>
        
        <!-- Use Material You dynamic color system accent for API 31+ 
             200 is standard for primary in night theme. -->
        <item name="android:colorAccent">@android:color/system_accent1_200</item>
    </style>

</resources>
